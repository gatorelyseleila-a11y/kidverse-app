# =============================================
# KIDVERSE - Configuration Environnement
# Copiez ce fichier vers .env et modifiez les valeurs
# =============================================

# Application
NODE_ENV=development

# URLs - Développement
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# URLs - Production (décommenter pour production)
# APP_URL=https://kidverse.app
# API_URL=https://kidverse.app

# URL publique pour le frontend (accessible côté client)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de données PostgreSQL
DATABASE_URL="postgresql://kidverse:kidverse_password@localhost:5432/kidverse_db?schema=public"

# Redis (Cache & Sessions)
REDIS_URL="redis://localhost:6379"

# Authentication (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Blockchain (Polygon)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_TESTNET_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_API_KEY
WALLET_PRIVATE_KEY=your-wallet-private-key
CONTRACT_ADDRESS=0x...

# Storage (S3 Compatible - Photos enfants, documents)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_access_key
S3_SECRET_KEY=minio_secret_key
S3_BUCKET=kidverse-uploads
S3_REGION=us-east-1

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@kidverse.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="KIDVERSE <noreply@kidverse.com>"

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Stripe (Paiements)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Twilio (SMS - Alertes urgentes)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Sentry (Error Tracking)
SENTRY_DSN=https://...@sentry.io/...

# Feature Flags
ENABLE_BLOCKCHAIN=true
ENABLE_AI_FEATURES=false
ENABLE_MOBILE_PUSH=true


